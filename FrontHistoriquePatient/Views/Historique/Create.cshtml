@model FrontHistoriquePatient.ViewModels.NoteViewModel

@{
    ViewData["Title"] = "Ajouter une note";
}

<h1>Ajouter une note</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="UneNote" class="control-label">Note</label>
                <textarea asp-for="UneNote" class="form-control" />
                <span asp-validation-for="UneNote" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                @Html.AntiForgeryToken()
                <input type="submit" value="Ajouter" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    @Html.ActionLink(
            "Retour",
            "Details",
            new { id = Model.PatientId }
            )
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
